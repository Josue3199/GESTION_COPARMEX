rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    // "admin": único rol que puede activar accesos (dar de alta correos en
    // `presidentesAutorizados`) y administrar la colección `usuarios`.
    function isAdmin() {
      return userDocExists() && userDoc().data.rol == 'admin';
    }

    // "directora": hace todo lo demás del panel (ver, aprobar,
    // rechazar, comentar planes) pero NUNCA activa accesos nuevos.
    function isDirectora() {
      return userDocExists() && userDoc().data.rol == 'directora';
    }

    function esStaff() {
      return isAdmin() || isDirectora();
    }

    // Usuario "activo": inició sesión Y ya tiene perfil en `usuarios`
    // (es decir, fue autorizado). Una cuenta de Google cualquiera que NO
    // fue autorizada ya no puede leer ni escribir nada de la plataforma.
    function isActivo() {
      return userDocExists();
    }

    function isPresidenteDe(comisionId) {
      return isSignedIn()
        && userDocExists()
        && userDoc().data.rol == 'presidente'
        && userDoc().data.comisionId == comisionId;
    }

    function correoAutorizado() {
      return (isSignedIn() && request.auth.token.email != null)
        ? request.auth.token.email.lower()
        : '';
    }

    function existeAutorizacion() {
      return correoAutorizado() != '' &&
        exists(/databases/$(database)/documents/presidentesAutorizados/$(correoAutorizado()));
    }

    function autorizacion() {
      return get(/databases/$(database)/documents/presidentesAutorizados/$(correoAutorizado())).data;
    }

    // Correos de Gmail autorizados por el admin (no hay correo
    // institucional): guarda tanto accesos de presidente como de
    // directora. Solo el admin los da de alta.
    match /presidentesAutorizados/{correo} {
      // Leer UN documento: el dueño del correo (necesario para el
      // auto-registro en su primer login) o cualquier usuario activo.
      allow get: if isSignedIn() && (correo == correoAutorizado() || isActivo());
      // Listar toda la colección (directorio, accesos): solo usuarios activos.
      allow list: if isActivo();
      // Admin administra las autorizaciones. Cada presidente puede actualizar
      // únicamente sus datos públicos de contacto; no puede cambiar rol/comisión.
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        correo == correoAutorizado() &&
        resource.data.rol == 'presidente' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombreDirectorio', 'correoContacto', 'telefono', 'empresa',
          'puesto', 'linkedin', 'actualizadoEn'
        ])
      );
    }

    match /usuarios/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || esStaff());

      // El admin crea/edita cualquier usuario. Además, una persona puede
      // crear SU PROPIO documento la primera vez que entra con Google, pero
      // solo si su correo fue autorizado antes y solo con el rol (y, si es
      // presidente, la comisión) que el admin definió para ese correo.
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        existeAutorizacion() &&
        request.resource.data.rol == autorizacion().rol &&
        (autorizacion().rol != 'presidente' ||
         request.resource.data.comisionId == autorizacion().comisionId)
      );

      // Un usuario YA registrado puede re-sincronizar su propio perfil con
      // lo que el admin autorizó (nombre, rol, comisión), pero nada más.
      // Sin esto, el segundo inicio de sesión de cualquier presidente
      // fallaba con permission-denied.
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        existeAutorizacion() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['rol', 'nombre', 'correo', 'comisionId']) &&
        request.resource.data.rol == autorizacion().rol &&
        (autorizacion().rol != 'presidente' ||
         request.resource.data.comisionId == autorizacion().comisionId)
      );

      allow delete: if isAdmin();
    }

    match /comisiones/{comisionId} {
      // Todos los usuarios ACTIVOS (admin, directora y CUALQUIER
      // presidente) pueden leer cualquier comisión: así todos los
      // presidentes son "visores" de los planes de todos.
      allow read: if isActivo();
      allow create, delete: if esStaff();

      // Admin y directora pueden editar todo (incl. aprobar/rechazar).
      // El presidente dueño de la comisión solo puede tocar su propio plan
      // (y las banderas de "tiene borrador"), y solo puede dejar el estado
      // oficial en 'borrador' o 'en_revision' (nunca aprobarlo).
      allow update: if esStaff() ||
        (
          isPresidenteDe(comisionId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['plan', 'estado', 'actualizadoEn', 'tieneBorrador', 'borradorActualizadoEn']) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado']) ||
            request.resource.data.estado == 'borrador' ||
            request.resource.data.estado == 'en_revision'
          )
        );

      // Borrador de trabajo (plan sin enviar): es privado del presidente
      // dueño mientras lo edita. Admin/directora solo pueden leerlo, para
      // saber que existe un plan a medio llenar y darle seguimiento — nunca
      // editarlo. El admin puede BORRARLO (necesario para eliminar una rama
      // completa con todo lo que cuelga de ella).
      match /borrador/{borradorId} {
        allow read: if esStaff() || isPresidenteDe(comisionId);
        allow write: if isPresidenteDe(comisionId);
        allow delete: if isAdmin();
      }

      // Notas/comentarios sobre el plan (no tocan el documento original).
      // Solo usuarios activos pueden leer y dejar una nota. El autor puede
      // editar el TEXTO de la suya; el staff o el presidente dueño del plan
      // solo pueden marcarla como leída (campo `leido`), no reescribirla.
      match /comentarios/{comentarioId} {
        allow read: if isActivo();
        allow create: if isActivo() &&
          request.resource.data.autorUid == request.auth.uid &&
          request.resource.data.leido == false;
        allow update: if
          (
            (esStaff() || isPresidenteDe(comisionId)) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leido'])
          ) ||
          (
            isSignedIn() && resource.data.autorUid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['texto'])
          );
        allow delete: if esStaff() || (isSignedIn() && resource.data.autorUid == request.auth.uid);
      }

      // Historial de versiones/estados del plan: es una bitácora, así que
      // solo se puede agregar (nunca editar). El presidente solo puede
      // registrar el envío a revisión; el staff registra cualquier cambio de
      // estado. Solo el admin puede borrar (al eliminar una rama completa).
      match /historial/{versionId} {
        allow read: if isActivo();
        allow create: if esStaff() ||
          (isPresidenteDe(comisionId) && request.resource.data.estado == 'en_revision');
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
  }
}
